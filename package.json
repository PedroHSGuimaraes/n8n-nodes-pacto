{
	"name": "n8n-nodes-pacto",
	"version": "1.1.0",
	"description": "n8n community node for the Pacto Soluções API, with all official OpenAPI operations available through Area → Operation selection.",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"pacto",
		"pacto solucoes",
		"academia",
		"fitness",
		"crm"
	],
	"license": "MIT",
	"homepage": "https://github.com/PedroHSGuimaraes/n8n-nodes-pacto#readme",
	"author": {
		"name": "Pedro Henrique Santos Guimarães",
		"email": "pedro.guimaraes02@hotmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/PedroHSGuimaraes/n8n-nodes-pacto.git"
	},
	"bugs": {
		"url": "https://github.com/PedroHSGuimaraes/n8n-nodes-pacto/issues"
	},
	"funding": {
		"type": "individual",
		"url": "https://buymeacoffee.com/qTny0AzFXS"
	},
	"main": "dist/nodes/Pacto/Pacto.node.js",
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"format": "prettier nodes credentials scripts test --write",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"test": "npm run build --silent && node --test --test-reporter=spec test/*.test.cjs",
		"update:catalog": "node scripts/update-pacto-catalog.mjs",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/PactoApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Pacto/Pacto.node.js"
		]
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"devDependencies": {
		"@n8n/node-cli": "0.55.5",
		"@types/node": "^24.0.0",
		"eslint": "9.32.0",
		"n8n-workflow": "^2.46.5",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	}
}
